# Monetura HQ (apps/hq)
# Copy to .env.local (gitignored). Never commit real values.

# Same MySQL as the other Monetura apps. If unset, HQ runs on an in-memory demo
# feed (still labelled Demo) and approvals are not persisted.
DATABASE_URL=

# Owner login for "/". Long random password.
HQ_OWNER_PASSWORD=
# Signs the owner session cookie. Generate: openssl rand -base64 32
HQ_SESSION_SECRET=

# "on" (default) lets owner polling append is_demo events. "off" stops new demo rows.
HQ_DEMO_MODE=on

# Bearer token for POST /api/hq/events/ingest (Atlas's hq-event tool). 48+ random
# bytes, base64url. If unset, ingest is disabled. Keep the real value in 1Password.
HQ_INGEST_TOKEN=
